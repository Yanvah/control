# Copy to .env.local for manual configuration, or run npm run dev:setup.
# HTTPS is mandatory in production. HTTP is allowed only on local development loopback.
CONTROL_URL=http://localhost:3000

# Generate three independent values: openssl rand -base64 32 (run separately for each).
CONTROL_AUTH_SECRET=
CONTROL_ENCRYPTION_KEY=
# Required only while the instance is unclaimed; remove after setup.
CONTROL_SETUP_TOKEN=

# Local development only. Production requires an absolute path below /data/.
DATABASE_PATH=./.data/control.db

# Product endpoints: keep false unless you explicitly need private connections.
# HTTP loopback fixtures require BOTH flags and non-production mode.
# Private HTTPS is allowed with the second flag; metadata targets remain blocked.
CONTROL_ALLOW_HTTP_ENDPOINTS=false
CONTROL_ALLOW_PRIVATE_ENDPOINTS=false
