{
  "name": "yanvah-control",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0 && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio --host 127.0.0.1",
    "dev:setup": "node --import tsx scripts/dev-setup.ts",
    "sdk:link": "node scripts/link-sdk.mjs",
    "setup:production": "node scripts/production-setup.mjs",
    "db:backup": "node scripts/database-maintenance.mjs backup",
    "db:verify": "node scripts/database-maintenance.mjs verify",
    "db:restore": "node scripts/database-maintenance.mjs restore",
    "test:release": "node --test scripts/release-metadata.test.mjs",
    "test:container": "node scripts/test-container.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.5",
    "@next/env": "16.3.5",
    "@tanstack/react-table": "9.2.4",
    "@yanvah/control": "0.2.1",
    "better-auth": "1.7.5",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "26.1.0",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
